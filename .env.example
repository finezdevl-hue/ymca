# YMCA Management System Configuration Example
# Copy to .env and adjust values for your environment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ymca_test

APP_ENV=development
APP_URL=http://localhost/ymca_test
APP_SECRET_KEY=replace_with_a_secure_random_key_min_32_characters
APP_ENABLE_QUERY_LOG=false

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="YMCA BCP"
MAIL_ENABLED=true
